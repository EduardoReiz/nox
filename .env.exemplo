# Copie para .env. Valores só para o ambiente local.
NOX_PG_SENHA=troque-esta-senha
NOX_INFLUX_SENHA=troque-esta-senha
NOX_INFLUX_TOKEN=troque-este-token
# Chave da cifra dos dados pessoais. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOX_CHAVE_DADOS=gere-uma-chave
# Notificações push (Web Push). Gere o par com:
# python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); ..." (ver docs/implementacoes/rf012_alertas.md)
NOX_VAPID_PRIVADA=gere-a-chave-privada
NOX_VAPID_PUBLICA=gere-a-chave-publica
NOX_VAPID_CONTATO=mailto:contato@seu-dominio
# Telegram: crie o bot com o @BotFather e cole o token e o nome do bot (sem @)
NOX_TELEGRAM_TOKEN=
NOX_TELEGRAM_BOT=
